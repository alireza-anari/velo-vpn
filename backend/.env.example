# Core
DATABASE_URL=postgresql+psycopg://velo:CHANGE_ME@127.0.0.1:5432/velo
JWT_SECRET=CHANGE_TO_A_LONG_RANDOM_SECRET
ENVIRONMENT=production
PUBLIC_BASE_URL=https://api.example.com
UPLOAD_DIR=/opt/velo/backend/uploads
AUTO_SCHEMA_CREATE=false
LOG_LEVEL=INFO
LOG_JSON=true
METRICS_ENABLED=true
METRICS_BEARER_TOKEN=CHANGE_TO_A_LONG_RANDOM_METRICS_TOKEN
READINESS_REQUIRE_VPN_SERVER=true
ADMIN_API_KEY=CHANGE_TO_A_LONG_RANDOM_ADMIN_KEY
ADMIN_PANEL_PASSWORD=CHANGE_TO_A_DIFFERENT_LONG_RANDOM_PASSWORD
ADMIN_SESSION_HOURS=12

# Email OTP / admin notifications
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
SMTP_FROM=Velo <noreply@example.com>
ADMIN_NOTIFICATION_EMAIL=
LEGAL_CONTACT_EMAIL=support@example.com
LEGAL_EFFECTIVE_DATE=2026-09-29

# Manual payment MVP
MANUAL_CARD_NUMBER=6037-XXXX-XXXX-1234
MANUAL_CARD_HOLDER=Velo

# Product defaults (all key economic values can later be overridden from admin settings)
TIMEZONE_NAME=Asia/Tehran
FREE_SPEED_MBPS=2
AD_REWARD_MINUTES=20
MAX_HEART_DISCOUNT_PERCENT=30

# Tapsell: Android Mediation app key is supplied at Android build time.
# Zone id remains remote-configurable from the backend/admin settings.
TAPSELL_APP_KEY=
TAPSELL_REWARDED_ZONE_ID=

# WireGuard single-node MVP
WIREGUARD_MANAGE_LOCAL=true
WIREGUARD_USE_SUDO=true
WIREGUARD_INTERFACE=wg0
WIREGUARD_SCRIPT_DIR=/opt/velo/wireguard
WIREGUARD_DEFAULT_DNS=1.1.1.1
VPN_CONNECT_FAILOVER_ATTEMPTS=3
VPN_HEARTBEAT_TIMEOUT_SECONDS=180
VPN_PEER_ACTIVITY_GRACE_SECONDS=240
NODE_HEALTH_INTERVAL_SECONDS=30
NODE_HEALTH_FAILURE_THRESHOLD=2
NODE_CIRCUIT_BREAKER_SECONDS=90
PEER_RECONCILE_INTERVAL_SECONDS=120

# Optional automatic first VPN server bootstrap
BOOTSTRAP_SERVER_NAME=Velo-1
BOOTSTRAP_SERVER_COUNTRY=DE
BOOTSTRAP_SERVER_CITY=Frankfurt
BOOTSTRAP_SERVER_ENDPOINT=YOUR_SERVER_IP:51820
BOOTSTRAP_SERVER_PUBLIC_KEY=YOUR_WIREGUARD_SERVER_PUBLIC_KEY
BOOTSTRAP_SERVER_CLIENT_CIDR=10.77.0.0/24

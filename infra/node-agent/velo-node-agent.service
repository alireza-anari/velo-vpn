[Unit]
Description=Velo VPN Node Agent
After=network-online.target wg-quick@wg0.service
Wants=network-online.target

[Service]
Type=simple
User=velo-agent
Group=velo-agent
EnvironmentFile=/etc/velo/node-agent.env
WorkingDirectory=/opt/velo/node-agent
ExecStart=/opt/velo/node-agent/.venv/bin/uvicorn app:app --host 0.0.0.0 --port 8787
Restart=always
RestartSec=3
# Node agent uses narrowly-scoped sudoers entries for wg/tc helpers.
NoNewPrivileges=false
PrivateTmp=true
ProtectSystem=strict
ProtectHome=true
ReadWritePaths=/run /tmp
UMask=0077
ProtectKernelTunables=true
ProtectKernelModules=true
ProtectControlGroups=true
RestrictSUIDSGID=true
LockPersonality=true

[Install]
WantedBy=multi-user.target

# Install as /etc/sudoers.d/velo and validate with: visudo -cf /etc/sudoers.d/velo
# Narrow root permissions for the Velo API service. Never allow arbitrary shell commands.
velo ALL=(root) NOPASSWD: /opt/velo/wireguard/add_peer.sh *, /opt/velo/wireguard/remove_peer.sh *, /opt/velo/wireguard/shape_peer.sh *, /opt/velo/wireguard/unshape_peer.sh *, /usr/bin/wg show wg0, /usr/bin/wg show wg0 transfer, /usr/bin/wg show wg0 allowed-ips, /usr/bin/wg show wg0 latest-handshakes
